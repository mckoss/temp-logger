{
  "dependencies": {
    "chart.js": "^4.4.7",
    "express": "^5.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "description": "Mac Studio temperature history logger — Node.js sampler, SQLite storage, web dashboard",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "main": "server.js",
  "name": "temp-logger",
  "scripts": {
    "demo": "node server.js --demo",
    "start": "node server.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "build": "node scripts/build.js",
    "check": "npm run build && npm test && npm run test:e2e",
    "test:install": "playwright install chromium",
    "sensors:check": "node scripts/check-sensors.js",
    "build:desktop": "node scripts/build-desktop.js",
    "service:install": "npm run build:desktop && node scripts/service.js install",
    "service:status": "node scripts/service.js status",
    "service:uninstall": "node scripts/service.js uninstall",
    "app": "node scripts/service.js open"
  },
  "type": "module",
  "version": "1.3.1",
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  },
  "optionalDependencies": {
    "macos-temperature-sensor": "^2.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mckoss/temp-logger.git"
  },
  "allowScripts": {
    "macos-temperature-sensor": true
  },
  "config": {
    "port": 49173
  }
}
